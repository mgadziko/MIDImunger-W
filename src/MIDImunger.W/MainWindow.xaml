<Window x:Class="MIDImunger.W.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MIDImunger-W" Height="700" Width="1080" MinHeight="500" MinWidth="780">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="MIDImunger-W" />
            <TextBlock Margin="16,7,0,0" Foreground="DimGray" Text="MIDI 1.0 monitor and router" />
            <Button DockPanel.Dock="Right" Padding="14,5" Click="AllNotesOff_Click" Content="All Notes Off" />
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Channels}" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Channel" Binding="{Binding Number}" Width="80" />
                <DataGridTextColumn Header="Last Message" Binding="{Binding LastMessage}" Width="*" />
                <DataGridTextColumn Header="Note" Binding="{Binding LastNote}" Width="90" />
                <DataGridTextColumn Header="Velocity" Binding="{Binding LastVelocity}" Width="90" />
                <DataGridTextColumn Header="Program" Binding="{Binding LastProgram}" Width="90" />
                <DataGridTextColumn Header="Controller" Binding="{Binding LastController}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="2" Header="MIDI log" Margin="0,12,0,12">
            <ListBox ItemsSource="{Binding LogEntries}" BorderThickness="0" />
        </GroupBox>

        <TextBlock Grid.Row="3" Foreground="DimGray" Text="{Binding Status}" />
    </Grid>
</Window>
